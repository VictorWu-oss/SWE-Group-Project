{
  "expo": {
    "name": "ToiletTracker",
    "slug": "toilet-tracker-cal-poly",
    "scheme": "toilettracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is optional and is used to sort nearby bathrooms and show your position on the campus map.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.victorwu1208.toilettrackercalpoly"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is optional and is used to sort nearby bathrooms and show your position on the campus map."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "root": "src/app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fa6c0706-9606-4e9b-9869-e4de55bbfee1"
      }
    }
  }
}
