    "build": "npm run build --workspace react-frontend",
    "check": "npm run test --workspace express-backend && npm run test --workspace mobile-app && npm run lint --workspace react-frontend && npm run build --workspace react-frontend && npm exec --workspace mobile-app -- tsc --noEmit",
