    "test": "npm run check",
    "dev:api": "npm run dev --workspace express-backend",
    "dev:mobile": "npm exec --workspace mobile-app -- expo start",
    "seed": "npm run seed --workspace express-backend",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc"
  },
